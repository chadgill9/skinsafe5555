# SkinSafe Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration
# Get these from your Supabase project settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Write Permission
# IMPORTANT: Writes are DISABLED by default for security.
# Set to 'true' only after you understand the security implications.
# With writes disabled:
#   - Product lookups (reads) still work
#   - Product submissions are saved locally only
#   - Scan analytics are not sent to database
# See docs/RISK_REGISTER.md for details.
EXPO_PUBLIC_ENABLE_SUPABASE_WRITES=false

# Note: The app works offline without Supabase configured.
# Products can still be manually entered and scored locally.
